# http2smtp — external side
# All values required (no defaults)

API_KEY=change-me

PORT=8080

SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM=Example Sender <noreply@example.com>
SMTP_INSECURE=false

# Optional healthchecks.io ping URL (pings once every 12 hours)
# HEALTHCHECK_URL=https://hc-ping.com/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
