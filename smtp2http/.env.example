# smtp2http — internal side
# Required: API_KEY, TARGET_URL, SMTP_DOMAIN, and at least one SMTP_USERS_<service> variable
# Optional: PORT (defaults to 8080), SMTP_TLS_DNS_NAMES

API_KEY=change-me

PORT=8080

TARGET_URL=https://your-http2smtp.example.com/send

# Specify domain for self-signed certificate and SMTP greeting
SMTP_DOMAIN=smtp2http.example.internal

# Optional comma-separated extra DNS names for the self-signed certificate
# SMTP_TLS_DNS_NAMES=*.example.internal,smtp.example.com

# Specify credentials using separate environment variables prefixed with SMTP_USERS_ (highly recommended for secret management):
SMTP_USERS_APP=app:change-me
SMTP_USERS_MONITOR=monitor:change-me-too
